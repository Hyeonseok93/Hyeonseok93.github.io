{
  "name": "notion-dashboard-blog",
  "version": "1.0.0",
  "description": "Vite-based static blog for GitHub Pages with TailwindCSS.",
  "scripts": {
    "build:posts": "node scripts/build-posts.js",
    "build:html:preview": "node build-html.js --target=preview",
    "build:html:vite-index": "node build-html.js --target=vite-index",
    "build:html:gh-pages": "node build-html.js --target=gh-pages && node scripts/validate-gh-pages.js",
    "build:assets": "npm run build:html:vite-index && vite build && node scripts/prune-legacy-woff.js",
    "dev": "npm run build:posts && npm run build:html:preview && vite",
    "build:gh-pages": "npm run build:posts && npm run build:assets && npm run build:html:gh-pages",
    "validate:gh-pages": "node scripts/validate-gh-pages.js",
    "build:all": "npm run build:gh-pages"
  },
  "keywords": [],
  "author": "Hyunm",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.5",
    "postcss": "^8.4.38",
    "sanitize-html": "^2.17.5",
    "tailwindcss": "^3.4.4",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "dompurify": "^3.4.11",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0"
  }
}
